local function SkidFling(TargetPlayer)
    local Character = Player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart

    if not Character or not Humanoid or not RootPart then
        return false
    end

    if Humanoid.Health <= 0 then
        return false
    end

    local TCharacter = TargetPlayer.Character
    if not TCharacter then return false end

    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local TRootPart = THumanoid and THumanoid.RootPart
    local THead = TCharacter:FindFirstChild("Head")
    local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
    local Handle = Accessory and Accessory:FindFirstChild("Handle")

    if THumanoid and THumanoid.Sit then return false end
    if not TCharacter:FindFirstChildWhichIsA("BasePart") then return false end

    local function FPos(BasePart, Pos, Ang)
        RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
        Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
        RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
        RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end

    local function SFBasePart(BasePart)
        local TimeToWait = 2
        local Time = tick()
        local Angle = 0
        repeat
            if RootPart and THumanoid then
                if BasePart.Velocity.Magnitude < 50 then
                    Angle = Angle + 100
                    FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                    task.wait()
                else
                    FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                    task.wait()
                end
            end
        until Time + TimeToWait < tick() or not FlingActive
    end

    workspace.FallenPartsDestroyHeight = 0/0

    local BV = Instance.new("BodyVelocity")
    BV.Parent = RootPart
    BV.Velocity = Vector3.new(0, 0, 0)
    BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

    if TRootPart then
        SFBasePart(TRootPart)
    elseif THead then
        SFBasePart(THead)
    elseif Handle then
        SFBasePart(Handle)
    else
        BV:Destroy()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        return false
    end

    BV:Destroy()
    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.CurrentCamera.CameraSubject = Humanoid

    if getgenv().OldPos then
        repeat
            RootPart.CFrame = getgenv().OldPos * CFrame.new(0, .5, 0)
            Character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, .5, 0))
            Humanoid:ChangeState("GettingUp")
            for _, part in pairs(Character:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new()
                end
            end
            task.wait()
        until (RootPart.Position - getgenv().OldPos.p).Magnitude < 25 or not FlingActive
        workspace.FallenPartsDestroyHeight = getgenv().FPDH
    end

    return true
end

local function StartFling()
    if FlingActive then return end

    UpdateTargetsList()
    local count = 0
    for _ in pairs(PlayersToFling) do count = count + 1 end

    if count == 0 then
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Ошибка",
            Text = "Нет целей для флинга!",
            Duration = 2
        })
        return
    end

    FlingActive = true
    StatusLabel.Text = "⚔️ Убиваю " .. count .. " игроков..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)

    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Старт",
        Text = "Флингуется " .. count .. " целей",
        Duration = 2
    })

    spawn(function()
        while FlingActive do
            local Character = Player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

            if not Character or not Humanoid or Humanoid.Health <= 0 then
                CharStatusLabel.Text = "💀 Ожидание перерождения..."
                CharStatusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                wait(2)
                continue
            else
                CharStatusLabel.Text = "✅ Персонаж жив"
                CharStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            end

            UpdateTargetsList()
            local validTargets = {}
            for name, player in pairs(PlayersToFling) do
                if player and player.Parent and player.Character then
                    local targetHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    if targetHumanoid and targetHumanoid.Health > 0 then
                        validTargets[name] = player
                    end
                else
                    PlayersToFling[name] = nil
                end
            end

            for _, player in pairs(validTargets) do
                if not FlingActive then break end
                if Player.Character and Player.Character:FindFirstChildOfClass("Humanoid") then
                    local h = Player.Character:FindFirstChildOfClass("Humanoid")
                    if h.Health > 0 then
                        SkidFling(player)
                    end
                end
                wait(0.1)
            end

            local cnt = 0
            for _ in pairs(PlayersToFling) do cnt = cnt + 1 end
            StatusLabel.Text = "⚔️ Убиваю " .. cnt .. " игроков..."
            UpdatePlayerList()
            wait(0.5)
        end
    end)
end

local function StopFling()
    if not FlingActive then return end
    FlingActive = false
    StatusLabel.Text = "⏸ Остановлен"
    StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Стоп",
        Text = "Флинг остановлен",
        Duration = 2
    })
end

local function PerformRejoin(instant)
    if FlingActive then StopFling() end
    RejoinCount = RejoinCount + 1
    PlatformCreated = false

    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = instant and "⚡ РЕДЖОЙН" or "Режойн",
        Text = "Поиск нового сервера #" .. RejoinCount .. "...",
        Duration = 2
    })

    local newServerId = GetRandomServer()

    if newServerId then
        LastServerId = newServerId
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "✅ Сервер найден",
            Text = "Переход на новый сервер...",
            Duration = 2
        })
        if not instant then wait(2) end
        TeleportService:Teleport(game.PlaceId, Player, nil, nil, nil, nil, nil, nil, nil, nil, true)
    else
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "⚠️ Не найден новый сервер",
            Text = "Попытка реджойна на случайный сервер...",
            Duration = 3
        })
        if not instant then wait(2) end
        TeleportService:Teleport(game.PlaceId, Player, nil, nil, nil, nil, nil, nil, nil, nil, true)
    end
end

local function StartRejoinTimer()
    if RejoinTimer then
        RejoinTimer:Disconnect()
        RejoinTimer = nil
    end

    local timeLeft = 600

    RejoinTimer = RunService.Heartbeat:Connect(function(dt)
        if AutoRejoinActive then
            timeLeft = timeLeft - dt
            if timeLeft <= 0 then
                PerformRejoin(false)
                RejoinTimer:Disconnect()
                return
            end
            if math.floor(timeLeft) % 5 == 0 then
                local mins = math.floor(timeLeft / 60)
                local secs = math.floor(timeLeft % 60)
                InfoLabel.Text = string.format("Режойн через: %02d:%02d | Всего: %d", mins, secs, RejoinCount)
            end
        end
    end)
end

