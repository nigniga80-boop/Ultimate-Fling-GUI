local function GetRandomServer()
    local success, result = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100")
    end)

    if not success then
        return nil
    end

    local data = game:GetService("HttpService"):JSONDecode(result)
    local servers = {}
    local currentServer = game.JobId

    if data and data.data then
        for _, server in ipairs(data.data) do
            -- Исключаем текущий сервер и сервер, на котором уже были
            if server.id ~= currentServer and server.id ~= LastServerId then
                local playerCount = server.playing or 0
                if playerCount < server.maxPlayers then
                    table.insert(servers, server.id)
                end
            end
        end
    end

    if #servers > 0 then
        return servers[math.random(1, #servers)]
    end
    
    -- Если нет других серверов, пробуем найти любой сервер кроме текущего
    if data and data.data then
        for _, server in ipairs(data.data) do
            if server.id ~= currentServer then
                local playerCount = server.playing or 0
                if playerCount < server.maxPlayers then
                    table.insert(servers, server.id)
                end
            end
        end
    end

    if #servers > 0 then
        return servers[math.random(1, #servers)]
    end

    return nil
end

local function UpdateTargetsList()
    PlayersToFling = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Player then
            local isExcluded = false
            for _, excluded in ipairs(ExcludedPlayers) do
                if player.Name == excluded then
                    isExcluded = true
                    break
                end
            end
            if not isExcluded then
                PlayersToFling[player.Name] = player
            end
        end
    end
    return #PlayersToFling
end

